        <mxCell id="layer2" value="信息怎样成为知识，再成为研究构思" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#183B50;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
