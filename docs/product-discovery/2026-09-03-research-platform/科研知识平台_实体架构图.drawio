        <mxCell id="intake" value="&lt;b style=&quot;font-size:24px&quot;&gt;01  信息入口&lt;/b&gt;&lt;br&gt;&lt;br&gt;dailyinfo / Inoreader / RSS&lt;br&gt;按期刊汇总新论文简介&lt;br&gt;人决定收录、暂存或跳过&lt;br&gt;产物：选中文献清单" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#223344;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=18;spacingTop=15;spacingBottom=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="460" width="320" height="210" />
        </mxCell>
        <mxCell id="zotero" value="&lt;b style=&quot;font-size:24px&quot;&gt;02  Zotero 文献库&lt;/b&gt;&lt;br&gt;&lt;br&gt;题录＋DOI＋PDF＋批注&lt;br&gt;区分所属库与全文状态&lt;br&gt;OA获取／机构或人工获取&lt;br&gt;原始资料留在来源存储" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#223344;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=18;spacingTop=15;spacingBottom=15;" vertex="1" parent="1">
