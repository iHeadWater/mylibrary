        <mxCell id="intake" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#223344;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=18;spacingTop=15;spacingBottom=15;" value="&lt;b style=&quot;font-size:24px&quot;&gt;01  信息入口&lt;/b&gt;&lt;br&gt;&lt;br&gt;dailyinfo / Inoreader / RSS&lt;br&gt;按期刊汇总新论文简介&lt;br&gt;人决定收录、暂存或跳过&lt;br&gt;产物：选中文献清单" vertex="1">
