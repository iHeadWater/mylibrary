    "activity_dir": "activity",
    "reports_dir": "reports",
    "prompts_dir": "hydrolitagent/cards/assets/prompts",
    "schemas_dir": "hydrolitagent/cards/assets/schemas"
  },
  "zotero": {
    "startup": {
      "enabled": true,
      "launch_if_missing": true,
      "executable": null,
      "wait_timeout_seconds": 120,
      "poll_interval_seconds": 5
    },
    "base_url": "http://127.0.0.1:23119",
    "group_id": "REPLACE_WITH_ZOTERO_GROUP_ID",
    "timeout_seconds": 5,
    "process_timeout_seconds": 5
  },
  "pdf_gate": {
    "min_file_size_bytes": 1024,
    "min_text_characters": 1000,
    "hash_chunk_size_bytes": 1048576
  },
  "tasks": {
    "lease_seconds": 1800,
    "lock_stale_seconds": 300,
    "max_history_entries": 100
  },
  "card_generator": {
    "proxy": {
      "enabled": false,
      "url": null,
      "no_proxy": [
        "localhost",
        "127.0.0.1",
        "::1"
      ]
    },
    "connection_guard": {
      "reconnect_stop_enabled": false,
      "reconnect_event_limit": 10,
      "recovery_timeout_seconds": 300,
      "idle_timeout_seconds": 1500,
      "pdf_tool_call_limit": 2
    },
    "progress": {
      "enabled": true,
      "heartbeat_interval_seconds": 60
    },
    "adapter": "codex_cli",
    "executable": "codex",
    "auth_mode": "chatgpt_account",
    "preflight_timeout_seconds": 10,
    "model": null,
    "reasoning_effort": null,
    "smoke_test_timeout_seconds": 120,
    "generation_timeout_seconds": 1500,
    "workflow_mode": "single_agent"
