{
  "schema_version": 1,
  "theme_pipeline": {
    "enabled": true,
    "research_goal": null,
    "model": null,
    "reasoning_effort": null,
    "timeout_seconds": null,
    "assets_dir": "hydrolitagent/cards/assets/templates/themes"
  },
  "pipeline": {
    "max_items_per_run": null,
