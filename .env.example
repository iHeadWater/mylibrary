# HydrolitAgent configuration
# Copy this file to .env and fill in the values you need.

# ── Output ──
# Where graph products (graph.json, graph.html, obsidian/, etc.) are written.
# Can be a local path or a cloud-synced folder (Google Drive, Dropbox, etc.).
# Override on the command line with --output.
HYDROLITAGENT_OUTPUT=outputs/graph

# ── LLM backends ──
# DeepSeek (recommended — cheapest for extraction, ~$1-3 per topic)
DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-chat  # optional model override

# Other supported backends (uncomment if needed):
# GEMINI_API_KEY=your-key-here
# KIMI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# ── Zotero Web API (read/write) ──
# Used by the Zotero MCP server, paper_to_zotero / zotero_sync / download_paper.py.
# On a bare host set them here (paper_to_zotero falls back to these when the
# TOML config is absent). Get a key: https://www.zotero.org/settings/keys
# NOTE: in the myopenclaw hermes container these come from
# /opt/data/.config/zot/config.toml instead — no .env needed there.
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user
# Zotero Local API (full-text access, requires Zotero Desktop running).
# Base = host root only; the server appends /api/users/0 itself.
# This file configures a BARE HOST, where host.docker.internal does not
# resolve, so loopback is the working value here.  Inside the container the
# compose file supplies its own value and wins (load_dotenv is additive).
# The older name ZOTERO_LOCAL_API_URL is still honoured.
ZOTERO_LOCAL_BASE_URL=http://127.0.0.1:23119
# In a container, use instead:
# ZOTERO_LOCAL_BASE_URL=http://host.docker.internal:23119

# ── Zotero linked_file sync (bare host; hydrolitagent/literature) ──
# GDRIVE_PAPERS_PATH must equal Zotero Desktop's "Linked Attachment Base Directory"
# (Settings → Advanced → Files and Folders); ZotMoov / auto-move must be OFF for it.
# Windows example: G:\我的云端硬盘\Documents\Papers\Zotero_Papers
GDRIVE_PAPERS_PATH=
# ZhipuAI (CogView) — used by wechat/figure.py for cover/figure generation
ZHIPUAI_API_KEY=
# WeChat Official Account — used by wechat/push.py (draft-box publishing)
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_THUMB_MEDIA_ID=
# NotebookLM CLI home — used by zotero_notebooklm.py (defaults to .tmp/notebooklm)
# NOTEBOOKLM_HOME=D:/code/mylibrary/.tmp/notebooklm
