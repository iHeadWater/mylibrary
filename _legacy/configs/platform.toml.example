# 专利/项目统计示例配置。
# 复制为 platform.toml 后填你自己的 Excel 路径与人名；真实配置不要提交。
#   cp configs/platform.toml.example configs/platform.toml

[input]
files = [
  "path/to/项目汇总表.xlsx",
  "path/to/专利汇总表.xlsx",
]

[output]
dir = "outputs"

[manual]
records_file = "configs/manual_records.toml"

[platform]
name = "示例平台"
story_axis = ["监测", "预警/预测", "调控"]
keywords = [
  "水网", "水文", "水资源", "水库", "流域", "洪水", "防洪", "降雨",
  "径流", "水质", "遥感", "测雨", "测流", "水位", "流量", "智慧水务",
  "智能", "人工智能", "深度学习", "大模型", "物理机制", "物理约束",
  "数据驱动", "调度", "调控", "决策", "数字孪生", "城市内涝",
  "hydrological", "hydrology", "flood", "rainfall", "runoff", "streamflow",
  "river network", "water level", "water quality", "groundwater", "reservoir",
  "urban flood", "floodwater", "rainfall-runoff", "physics-based"
]

# 示例人名与别名；换成你自己的名单。
[people.allowlist]
"张三" = ["张三", "Zhang San", "San Zhang"]
"李四" = ["李四", "Li Si", "Si Li"]
"王五" = ["王五", "Wang Wu", "Wu Wang"]

[record_types.patent]
enabled = true
sheet_keywords = ["专利", "授权", "受理"]
exclude_sheet_keywords = ["驳回"]
title_columns = [1]
summary_columns = []
people_columns = [2]
venue_columns = [5, 6]
identifier_columns = [7, 8, 14]

[record_types.patent.time]
start_date = "2025-06-01"
date_policy = "record_or_status"
status_terms = ["申请", "受理", "公开", "授权", "年费", "申请费"]
status_can_bypass_date_terms = []
status_from_sheet = true
keep_year_only_if_year_at_least = 2025

[record_types.project]
enabled = true
sheet_keywords = ["项目"]
exclude_sheet_keywords = ["已结题"]
title_columns = [7, 2]
summary_columns = []
people_columns = [8, 6]
venue_columns = [5, 6]
identifier_columns = [9, 7]

[record_types.project.time]
start_date = "2025-06-01"
date_policy = "coverage_overlap"
status_terms = ["在研", "新立项", "执行", "重点研发", "国家自然科学基金", "青年科学基金", "面上项目"]
status_can_bypass_date_terms = []
status_from_sheet = false
keep_year_only_if_year_at_least = 2025

[tracks."监测"]
keywords = [
  "监测", "观测", "感知", "遥感", "水质", "视频", "图像", "无人机",
  "传感", "多源", "数据融合", "雨量", "测雨", "测流", "水位", "流量",
  "内涝水深", "水深", "反演", "影像", "地面视角", "估算", "摄像头", "多模态",
  "monitoring", "estimation", "camera", "image", "remote sensing", "water level",
  "floodwater", "multimodal", "hydrological stations"
]
prompt = "围绕多源观测、智能感知、遥感/视频/传感数据融合，说明平台如何补齐水网运行的数据底座。"

[tracks."预警/预测"]
keywords = [
  "预测", "预报", "预警", "径流", "洪水", "水文模型", "时序", "大模型",
  "神经网络", "深度学习", "模拟", "无资料", "降雨", "水文水动力",
  "耦合物理机制", "物理约束", "物理启发", "数据驱动", "机理融合",
  "人工智能融合建模", "PINN", "forecast", "prediction", "streamflow",
  "rainfall-runoff", "hydrological model", "data-limited", "physics-based",
  "differentiable", "machine learning"
]
prompt = "围绕耦合物理机制与深度学习、物理约束/物理启发的数据驱动模型、水文机理与人工智能融合建模，说明平台如何提升水文预报与风险预警能力。"

[tracks."调控"]
keywords = [
  "调控", "调度", "决策", "优化", "水库", "水网", "强化学习", "智能体",
  "数字孪生", "预案", "供水", "防洪", "多目标", "协同", "生态调度",
  "人机协同", "operation", "optimization", "reservoir", "water resource management",
  "groundwater management", "ecological flow"
]
prompt = "围绕水库/水网调度、智能优化、数字孪生和决策支持，说明平台如何服务水网安全高效运行。"
