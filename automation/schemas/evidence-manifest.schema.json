{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydro-platform.local/schemas/evidence-manifest.schema.json",
  "title": "Hydro Platform Evidence Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "group_id",
    "parent_key",
    "attachment_key",
    "pdf_sha256",
    "source_task_id",
    "title",
    "card_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-[A-Za-z0-9]+$"
    },
    "group_id": {
      "type": "integer",
      "minimum": 1
    },
    "parent_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+$"
    },
    "attachment_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+$"
    },
    "pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "card_status": {
      "enum": [
        "PLACEHOLDER",
        "ROUGH"
      ]
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_adapter",
        "generator_protocol_version",
        "cli_version",
        "model",
        "reasoning_effort",
        "prompt_version",
        "prompt_sha256",
        "output_schema_version",
        "output_schema_sha256",
        "template_catalog_version",
        "template_id",
        "template_version",
        "template_source_commit",
        "template_content_sha256",
        "classification_confidence",
        "classification_reason",
        "reading_scope",
        "source_access_verified",
        "source_access_method",
        "source_access_server",
        "source_access_receipt_schema_version",
        "source_pages_served",
        "source_visual_pages_served",
        "source_read_status",
        "source_page_count",
        "visual_content_status",
        "source_read_evidence",
        "generated_at",
        "card_sha256",
        "usage"
      ],
      "properties": {
        "generator_adapter": {
          "type": "string",
          "minLength": 1
        },
        "generator_protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "cli_version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_schema_version": {
          "const": 2
        },
        "output_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "template_catalog_version": {
          "type": "string",
          "minLength": 1
        },
        "template_id": {
          "type": "string",
          "minLength": 1
        },
        "template_version": {
          "type": "string",
          "minLength": 1
        },
        "template_source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "template_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "classification_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "classification_reason": {
          "type": "string",
          "minLength": 1
        },
        "reading_scope": {
          "const": "FULL_PDF"
        },
        "source_access_verified": {
          "type": "boolean"
        },
        "source_access_method": {
          "enum": [
            "bound_local_pdf_mcp",
            "local_pdf_path"
          ]
        },
        "source_access_server": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_access_receipt_schema_version": {
          "enum": [
            1,
            null
          ]
        },
        "source_pages_served": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_visual_pages_served": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_access": {
          "type": "object"
        },
        "source_read_status": {
          "const": "FULL_PDF_REVIEWED"
        },
        "source_page_count": {
          "type": "integer",
          "minimum": 1
        },
        "visual_content_status": {
          "enum": [
            "REVIEWED",
            "NOT_PRESENT"
          ]
        },
        "source_read_evidence": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "card_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quality_status": {
          "enum": [
            "VALIDATED",
            "STRUCTURE_VALIDATED"
          ]
        },
        "workflow_protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "workflow_role_count": {
          "enum": [
            1,
            6
          ]
        },
        "quality_audit_file": {
          "const": "quality-audit.json"
        },
        "quality_audit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "usage": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_access_method": {
                "const": "local_pdf_path"
              }
            }
          },
          "then": {
            "required": [
              "source_access",
              "quality_status",
              "workflow_protocol_version",
              "workflow_role_count",
              "quality_audit_file",
              "quality_audit_sha256"
            ],
            "properties": {
              "source_access_verified": {
                "const": false
              },
              "source_access_server": {
                "type": "null"
              },
              "source_access_receipt_schema_version": {
                "type": "null"
              },
              "source_pages_served": {
                "type": "null"
              },
              "source_visual_pages_served": {
                "type": "null"
              },
              "workflow_protocol_version": {
                "enum": [
                  "rough-card-multi-agent-v2",
                  "rough-card-single-agent-v1"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "source_access_verified": {
                "const": true
              },
              "source_access_server": {
                "type": "string",
                "minLength": 1
              },
              "source_access_receipt_schema_version": {
                "const": 1
              },
              "source_pages_served": {
                "type": "integer",
                "minimum": 1
              },
              "source_visual_pages_served": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "workflow_protocol_version"
            ],
            "properties": {
              "workflow_protocol_version": {
                "const": "rough-card-single-agent-v1"
              }
            }
          },
          "then": {
            "required": [
              "quality_status",
              "workflow_role_count"
            ],
            "properties": {
              "source_access_method": {
                "const": "local_pdf_path"
              },
              "quality_status": {
                "const": "STRUCTURE_VALIDATED"
              },
              "workflow_role_count": {
                "const": 1
              }
            }
          },
          "else": {
            "properties": {
              "quality_status": {
                "const": "VALIDATED"
              },
              "workflow_role_count": {
                "const": 6
              }
            }
          }
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "card_status": {
            "const": "ROUGH"
          }
        }
      },
      "then": {
        "required": [
          "generation"
        ]
      },
      "else": {
        "not": {
          "required": [
            "generation"
          ]
        }
      }
    }
  ]
}
